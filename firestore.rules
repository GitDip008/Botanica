rules_version = '2';

// Botanica Firestore security rules.
//
// Model:
//  • Each user owns /users/{uid} and its /chats subcollection — nobody else can
//    read them (this is what guarantees "no user can read another user's data").
//  • Admins are identified by their verified auth-token email (NOT a client-set
//    field), so the isAdmin flag can never be forged to escalate privileges.
//  • Collections written only by Cloud Functions (admin SDK bypasses rules) are
//    locked to the client entirely.
//  • Anything not explicitly listed is denied by the final catch-all.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin = verified token email on the allow-list. Mirrors AppUser.adminEmails.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'admin@botanica.fi',
        'shourovdip147@gmail.com'
      ];
    }

    // A normal user may write their own doc, but may NOT grant themselves staff
    // powers. Both the privilege fields the agent trusts — isAdmin and role —
    // can only be set to an elevated value by an actual admin. This blocks a
    // visitor from self-promoting to gardener/admin (which would let them write
    // to the live garden database). A normal user may only set role to 'visitor'.
    function privFieldsSafe() {
      return (!('isAdmin' in request.resource.data)
              || request.resource.data.isAdmin == false
              || isAdmin())
        && (!('role' in request.resource.data)
              || request.resource.data.role == 'visitor'
              || isAdmin());
    }

    // ── Users (profile, tier, badges, fcmToken) + private chat history ──
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && privFieldsSafe();
      allow update: if (isOwner(uid) && privFieldsSafe()) || isAdmin();
      allow delete: if isAdmin();

      // Chat history is strictly private to its owner.
      match /chats/{chatId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Events ───────────────────────────────────────────────────────────
    // Anyone signed-in may submit a request and may read approved+public events
    // or their own submissions. Admins manage everything. RSVP lets any signed-in
    // user toggle ONLY the rsvpUserIds field on an event.
    match /events/{eventId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn()
            && resource.data.status == 'approved'
            && resource.data.isPublic == true);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['rsvpUserIds']));

      allow delete: if isAdmin();
    }

    // ── Visitor reports — submit only; admin reads. ──────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Feature usage counters — increment by signed-in users, admin reads.
    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    // ── Public config (app version, holiday hours) — world-readable, admin
    //    (and server) writes. ──────────────────────────────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Visitor contests ────────────────────────────────────────────────
    //
    // The contest itself lives in /config/contest (covered above: world-read,
    // admin-write), so an event is ended by flipping a field, not a release.
    //
    // Entries are world-readable because the leaderboard is built from them on
    // the device. They carry a plant name, a display name and slider values —
    // no photo bytes. The photo is a Storage object readable only by its owner.
    match /contest_entries/{doc} {
      allow read: if isSignedIn();

      // A visitor may only write an entry that is their own, and only at the
      // deterministic id contest__uid__plant. That id is what enforces "one
      // entry per plant per person": a second submission overwrites the first
      // instead of adding a vote, so the leaderboard cannot be farmed.
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && doc == request.resource.data.contestId + '__' + request.auth.uid
                  + '__' + request.resource.data.plantKey;

      // Entries stand once cast — same append-only principle as the garden's
      // records. An admin can remove an inappropriate one server-side.
      allow delete: if false;
    }

    match /contest_teams/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      // Joining and leaving are the only permitted edits, and only ever to
      // one's own membership — nobody can rename a team or evict a member.
      allow update: if isSignedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'memberNames']);

      allow delete: if isAdmin();
    }

    // ── Server-only collections (Cloud Functions / admin SDK bypass rules).
    //    No client may ever touch these. ──────────────────────────────────
    match /rate_limits/{doc}      { allow read, write: if false; }
    match /agent_audit_log/{doc}  { allow read, write: if false; }
    match /agent_corrections/{doc}{ allow read, write: if false; }
    match /agent_pending/{doc}    { allow read, write: if false; }
    match /agent_writes/{doc}     { allow read, write: if false; }
    // Update-mode slots. Client-writable would let a visitor hand themselves a
    // half-built write intent, so it stays admin-SDK only like the rest.
    match /agent_update_mode/{doc}{ allow read, write: if false; }

    // ── Default deny for anything not matched above. ─────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
