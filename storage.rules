rules_version = '2';

// Botanica Storage rules.
//
// Two things live in Storage:
//   • agent_live/live.sqlite — read/written only by Cloud Functions via the
//     Admin SDK, which bypasses these rules. No client may touch it.
//   • contests/{contestId}/{uid}/… — visitor contest photos.
//
// Contest photos are readable by the person who took them and by an admin, and
// by nobody else. The leaderboard ranks plants, not pictures, so no visitor
// ever needs to see another visitor's photo — which keeps a public event with
// an open sign-up from producing a publicly readable photo bucket. The admin
// exception exists because resolving a prize means checking that a submission
// is really the plant it claims to be.
service firebase.storage {
  match /b/{bucket}/o {

    // Same allow-list as firestore.rules isAdmin() and AppUser.adminEmails.
    // Keep the three in step.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'admin@botanica.fi',
        'shourovdip147@gmail.com'
      ];
    }

    match /contests/{contestId}/{uid}/{fileName} {
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isAdmin();

      // Write is capped and typed at the rule level, not just in the app: an
      // uncapped bucket on a free tier is how an event becomes a bill.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Photos are never deleted from the client — same append-only principle
      // the garden records follow.
      allow delete: if false;
    }

    // Private gallery photos from the WEB build only. The browser has no app
    // directory to keep them in and localStorage cannot hold photographs, so on
    // web a "private" photo has to live server-side — readable by nobody but
    // its owner. Deliberately NO admin exception: this is a visitor's private
    // diary, not a competition entry, and nothing in the app needs to read it.
    // On Android these never exist; the file stays on the phone.
    match /gallery_private/{uid}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Visitor gallery. Anything in this path is by definition already public:
    // a private post is never uploaded at all, so there is nothing here to
    // leak. Readable by any signed-in visitor, which is what the feed needs.
    match /gallery/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Unlike the garden's records, this is the visitor's own content — they
      // may take it back. Unpublishing deletes the object so it stops costing
      // storage as well as stopping being visible.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
